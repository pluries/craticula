<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Versions mirror csharp/Directory.Packages.props. Dapper and MongoDB.Driver also reach the demo through the
       Craticula adapters; the demo references them directly because it owns the real connections. -->
  <ItemGroup>
    <!-- The released Craticula packages (nuget.org); the demo shows the library as a user installs it. A bump is a deliberate change. -->
    <PackageVersion Include="Craticula.Core" Version="1.0.0" />
    <PackageVersion Include="Craticula.AgGrid" Version="1.0.0" />
    <PackageVersion Include="Craticula.Sql" Version="1.0.0" />
    <PackageVersion Include="Craticula.Dapper" Version="1.0.0" />
    <PackageVersion Include="Craticula.EntityFrameworkCore" Version="1.0.0" />
    <PackageVersion Include="Craticula.Mongo" Version="1.0.0" />
    <PackageVersion Include="Craticula.MongoDB.Driver" Version="1.0.0" />
    <PackageVersion Include="Craticula.Search" Version="1.0.0" />
    <PackageVersion Include="Craticula.OpenSearch.Client" Version="1.0.0" />
    <PackageVersion Include="Craticula.Export.Csv" Version="1.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The EF Core providers for the demo's two extra EF routes (#2554); the version matches the Microsoft.EntityFrameworkCore that
         MySql.EntityFrameworkCore needs (10.0.12, which Microsoft.Data.Sqlite now shares). New libraries (MIT): the Engineering Lead's approval is pending. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Oracle's MySQL provider (GPL-2.0-only WITH Universal-FOSS-exception-1.0), demo only; it needs EF Core 10.0.12. -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="OpenSearch.Client" Version="2.2.0" />
    <!-- A security pin, not a new library (same as csharp/Directory.Packages.props, #1660): SqlClient 7.1.0 depends on
         System.Security.Cryptography.Pkcs 9.0.18, which has a high and a moderate advisory (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7), patched in 10.0.13. Drop this line and the reference in Api/Demo.Api.csproj once a SqlClient
         release depends on a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
