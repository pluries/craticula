<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Demo.Api</RootNamespace>
    <AssemblyName>Demo.Api</AssemblyName>
  </PropertyGroup>

  <!-- The ten Craticula packages from nuget.org; the version is pinned in ../Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Craticula.Core" />
    <PackageReference Include="Craticula.AgGrid" />
    <PackageReference Include="Craticula.Sql" />
    <PackageReference Include="Craticula.Dapper" />
    <PackageReference Include="Craticula.EntityFrameworkCore" />
    <PackageReference Include="Craticula.Mongo" />
    <PackageReference Include="Craticula.MongoDB.Driver" />
    <PackageReference Include="Craticula.Search" />
    <PackageReference Include="Craticula.OpenSearch.Client" />
    <PackageReference Include="Craticula.Export.Csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <!-- The low-level client (IOpenSearchLowLevelClient) the OpenSearch provider owns; Craticula.OpenSearch.Client never builds one. -->
    <PackageReference Include="OpenSearch.Client" />
    <!-- Not used by name: lifts SqlClient's transitive System.Security.Cryptography.Pkcs to a patched version (Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../orders.schema.json" Link="orders.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
