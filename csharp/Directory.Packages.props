<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- #1646: Craticula.Dapper's one runtime dependency. Moved to 2.1.89 by #3031 (the newest release at least two weeks old
         on 2026-10-25, published 2026-09-23). -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!-- #1646: Craticula.Dapper.Tests' own test-only provider (mirrors why
         Craticula.EntityFrameworkCore.Tests references Microsoft.EntityFrameworkCore.Sqlite — the
         adapter under test never references a provider itself). Pinned to the same 10.0.12 family as
         the EF Core packages above (#3031: 10.0.13 was 11 days old on 2026-10-25) rather than the bare package's own latest, since this repo already
         targets that release line for net10.0. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- #1647: Craticula.MongoDB.Driver's one runtime dependency. Moved to 3.13.0 by #3031, a recorded exception to the
         two-week rule (published 2026-10-22, 3 days old on 2026-10-25): 3.13.0 fixes CVE-2026-114643 to -114654, which 3.12.0 and
         earlier carry and which NVD had not yet matched to a CPE (maker's decision, 2026-10-25; the Pkcs pin below is the same kind
         of exception). Unlike Dapper's ADO.NET
         abstraction, MongoDB has exactly one .NET driver, so Craticula.MongoDB.Driver.Tests references
         the SAME package directly (as the host owning the real connection) rather than a separate
         test-only provider. -->
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <!-- #1648: Craticula.OpenSearch.Client's one runtime dependency. Moved to 2.2.0 by #3031 (the newest release at least two
         weeks old on 2026-10-25, published 2026-09-23). Craticula.OpenSearch.Client.Tests
         references the SAME package directly (as the host owning the real connection), mirroring
         Craticula.MongoDB.Driver.Tests' own precedent rather than Craticula.Dapper.Tests' separate-provider one:
         OpenSearch.Client is both the wire protocol AND the low-level client this package executes through. -->
    <PackageVersion Include="OpenSearch.Client" Version="2.2.0" />
    <!-- #1655 (#2205): the execution-equality tier's test-only packages, approved in docs/compliance/tech-stack.approved.md
         on 2026-10-10 and used by Craticula.Integration.Tests only (AR-3). Each is the newest stable release at least two
         weeks old on 2026-10-10 (nuget.org): Testcontainers 4.15.0 (2026-09-06; moved to 4.16.0 by #3031, published 2026-10-08, 16 days old on 2026-10-25), Npgsql 10.0.3, MySqlConnector 2.6.2,
         Microsoft.Data.SqlClient 7.1.0 (2026-09-18). Elasticsearch needs no client package (raw HttpClient, #2207). -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.OpenSearch" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Elasticsearch" Version="4.16.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!-- #2882 (story #2880, OQ-6): Oracle joins the execution-equality tier, approved in docs/compliance/tech-stack.approved.md on
         2026-10-22 and used by Craticula.Integration.Tests only (AR-3), never by a package under csharp/src/.
         Oracle.ManagedDataAccess.Core is under Oracle's own free-use terms (not open source), so it is allowed in test code
         only (ADR 0003). 23.26.301 is the newest release at least two weeks old on 2026-10-22 (published 2026-09-08; 23.26.400
         is from 2026-10-20). Testcontainers.Oracle stays on the version of the other modules. -->
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.16.0" />
    <!-- #1660 (NuGetAudit, NU1903): a security pin, not a new library. Microsoft.Data.SqlClient 7.1.0 (and 7.1.1, the
         newest on 2026-10-15) depends on System.Security.Cryptography.Pkcs 9.0.18, which carries a high and a moderate
         .NET denial-of-service advisory published 2026-10-13: https://github.com/advisories/GHSA-846f-f764-76mx
         (CVE-2026-84008) and https://github.com/advisories/GHSA-2fmv-rv2c-59x7 (CVE-2026-70162); patched in 9.0.21 and
         10.0.13. Oracle.ManagedDataAccess.Core (#2882) depends on 8.0.1, which carries the same two advisories. Craticula.Integration.Tests
         references it directly to lift the transitive version; drop both lines once a SqlClient release and an Oracle driver
         release both depend on a patched version. 10.0.13 matches this repo's net10.0 release line. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- #3032: the test tooling moved to the newest releases at least two weeks old on 2026-10-25 (nuget.org): coverlet.collector 10.1.0,
         Microsoft.NET.Test.Sdk 18.10.1 (18.11.0 was 11 days old), xunit.runner.visualstudio 4.0.1. Each was tried alone against the offline suite;
         scripts/coverage.sh gave the same line coverage per assembly as with coverlet 6.0.4. xunit stays 2.9.3 (the v3 move is out of scope). -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
