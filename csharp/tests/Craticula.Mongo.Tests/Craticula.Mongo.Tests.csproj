<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Craticula.Mongo/Craticula.Mongo.csproj" />
    <!-- The conformance tests drive the REAL end-to-end path a host uses (AgGridRequestParser ->
         GridFilterPipeline -> MongoPipelineBuilder), so the test project references the adapter even
         though Craticula.Mongo itself deliberately does not. -->
    <ProjectReference Include="../../src/Craticula.AgGrid/Craticula.AgGrid.csproj" />
    <!-- ...and the SQL compiler, for the cross-compiler grouping test alone: the DoD claims the two
         backends make the SAME GRP-* decisions, which no per-backend artifact suite can check
         because each only ever compares a compiler against its own hand-written arm. -->
    <ProjectReference Include="../../src/Craticula.Sql/Craticula.Sql.csproj" />
    <!-- The compile-only Mongo sample (spec 005, US6): its tests run the entry point and compare the output with the recorded file. -->
    <ProjectReference Include="../../samples/Craticula.Quickstart.Mongo/Craticula.Quickstart.Mongo.csproj" />
  </ItemGroup>

</Project>
