<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Craticula execution adapter for the official MongoDB .NET driver: compiles the IR to an aggregation pipeline and runs it.</Description>
    <RootNamespace>Craticula.MongoDB.Driver</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Craticula.MongoDB.Driver.Tests" />
    <InternalsVisibleTo Include="Craticula.MongoDB.Driver.Offline.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package's one runtime dependency. Version centrally managed in
         csharp/Directory.Packages.props — this file names the package and, via VersionOverride, the published range
         (#1658: the nuspec range; restore still resolves its lowest version, the tested one). Unlike Craticula.Dapper's
         ADO.NET abstraction (any provider), MongoDB has exactly one .NET driver, so this reference is
         both the wire protocol AND the document model (BsonDocument/BsonValue) this package reads
         values back through. -->
    <PackageReference Include="MongoDB.Driver" VersionOverride="[3.13.0,4.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Craticula.Core AND Craticula.Mongo — the SAME resolution #1646 reached for Dapper→Sql, not EF
         Core's AR-4 exception. EfCoreEntityFrameworkCore compiles IR straight to IQueryable<T>
         expression trees and never produces a backend-specific artifact, so it references Core only;
         every other execution adapter compiles its own IR through its own compiler as a normal,
         intended production edge (docs/architecture/c4-containers.md:
         `Rel(mongoc, mongoad, "Aggregation pipeline")`). This package's whole job is executing the
         pipeline Craticula.Mongo.MongoPipelineBuilder.Build already produces — it never re-derives a
         SEM-*/MDB-* rendering rule of its own. -->
    <ProjectReference Include="../Craticula.Core/Craticula.Core.csproj" />
    <ProjectReference Include="../Craticula.Mongo/Craticula.Mongo.csproj" />
  </ItemGroup>

  <!-- Not Craticula.AgGrid: this adapter's own ToGridPageResult() extension (#1649) names
       Craticula.AgGrid.LoadSuccessParamsMapper.Map only in a plain-prose doc comment (a <c> tag, not a <see cref>): src/Directory.Build.props turns on GenerateDocumentationFile (#1658), so every
         <see cref> is compiler-checked, and a cref to Craticula.AgGrid would need the very reference this package
         must not have. This package still only ever
       executes the pipeline Craticula.Mongo.MongoPipelineBuilder.Build produces. -->

</Project>
