<Project>

  <!-- The shared settings first: MSBuild stops at the nearest Directory.Build.props, so this file must import
       csharp/Directory.Build.props (target framework, nullable, NuGetAudit) or the src projects would lose them. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <!-- #1660 (TRD P-3, SAST): the SDK's Roslyn security rules on the shipped libraries only. The analyzers ship with
       the .NET SDK (Microsoft.CodeAnalysis.NetAnalyzers), so this adds no package. Test projects and tools import
       csharp/Directory.Build.props directly and are unaffected.

       AnalysisModeSecurity=All turns on every rule of the Security category, including the ones disabled by default,
       and leaves every other category exactly as the SDK default has it (no AnalysisMode change: the style and
       quality backlog stays off). csharp/src/.editorconfig then raises the Security rules to errors, so a finding
       fails the build. A Security rule a later SDK adds shows up here as a warning first, which the 0-warning bar
       catches; add it to the .editorconfig list. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
  </PropertyGroup>

  <!-- #1658: NuGet packaging for the ten shipped libraries. Version is the one property the release bumps. Tools and
       tests keep IsPackable=false from csharp/Directory.Build.props; only src projects import this file's settings. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>1.1.0</Version>
    <Authors>Christian Stephan</Authors>
    <Company>Pluries</Company>
    <Copyright>Copyright (c) Christian Stephan</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pluries/craticula</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pluries/craticula</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ag-grid;ssrm;server-side-row-model;query-compiler;sql;mongodb;opensearch;elasticsearch</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Reproducible, debuggable packages: embedded PDB, SourceLink (built into the SDK), deterministic paths in CI. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TF_BUILD)' != '' Or '$(GITHUB_ACTIONS)' != ''">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- XML docs make every <see cref> compiler-checked. CS1591 (missing comment on a public member) stays off. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

</Project>
