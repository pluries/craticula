<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Craticula execution adapter for OpenSearch.Client: compiles the IR to a search body and runs it, with deep paging and streamed export.</Description>
    <RootNamespace>Craticula.OpenSearch.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- #1648's ComputeCursorKey (the cache-key hash, {query, sort}/{query, composite.sources}) has no
         live cluster to execute against for a pure determinism check — mirroring
         Craticula.Dapper.Tests' access to DapperParameterBinder.ToTypedArray for the identical reason:
         granting the test project access to this one internal type lets the hashing LOGIC be
         unit-tested directly instead of left unverified. -->
    <InternalsVisibleTo Include="Craticula.OpenSearch.Client.Tests" />
    <InternalsVisibleTo Include="Craticula.OpenSearch.Client.Offline.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package's one runtime dependency. Version centrally managed in
         csharp/Directory.Packages.props — this file names the package and, via VersionOverride, the published range
         (#1658: the nuspec range; restore still resolves its lowest version, the tested one). -->
    <PackageReference Include="OpenSearch.Client" VersionOverride="[2.2.0,3.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Craticula.Core AND Craticula.Search — the SAME resolution #1646/#1647 reached for
         Dapper→Sql/MongoDB.Driver→Mongo, not EF Core's AR-4 exception. This package's whole job is
         executing the search body Craticula.Search.SearchQueryBuilder.Build already produces — it never
         re-derives a SEM-*/OSE-* rendering rule of its own. -->
    <ProjectReference Include="../Craticula.Core/Craticula.Core.csproj" />
    <ProjectReference Include="../Craticula.Search/Craticula.Search.csproj" />
  </ItemGroup>

  <!-- Not Craticula.AgGrid: this adapter's own ToGridPageResult() extension (#1649) names
       Craticula.AgGrid.LoadSuccessParamsMapper.Map only in a plain-prose doc comment (a <c> tag, not a <see cref>): src/Directory.Build.props turns on GenerateDocumentationFile (#1658), so every
         <see cref> is compiler-checked, and a cref to Craticula.AgGrid would need the very reference this package
         must not have. This package still only ever
       executes the search body Craticula.Search.SearchQueryBuilder.Build produces. -->

</Project>
